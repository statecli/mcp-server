{
  "name": "statecli",
  "displayName": "StateCLI - AI Agent Memory & Undo",
  "description": "Memory, replay, and undo capability for AI coding agents. One-click MCP server setup.",
  "version": "0.5.2",
  "publisher": "statecli",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/statecli/mcp-server"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "mcp",
    "ai",
    "agent",
    "undo",
    "state",
    "replay",
    "claude",
    "cursor",
    "windsurf"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "statecli-sidebar",
          "title": "StateCLI",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "statecli-sidebar": [
        {
          "id": "statecli.historyView",
          "name": "Change History"
        },
        {
          "id": "statecli.checkpointsView",
          "name": "Checkpoints"
        },
        {
          "id": "statecli.actionsView",
          "name": "Quick Actions"
        }
      ]
    },
    "commands": [
      {
        "command": "statecli.setup",
        "title": "StateCLI: Setup MCP Server",
        "icon": "$(gear)"
      },
      {
        "command": "statecli.showTools",
        "title": "StateCLI: Show Available Tools",
        "icon": "$(tools)"
      },
      {
        "command": "statecli.checkpoint",
        "title": "StateCLI: Create Checkpoint",
        "icon": "$(bookmark)"
      },
      {
        "command": "statecli.replay",
        "title": "StateCLI: Replay Changes",
        "icon": "$(history)"
      },
      {
        "command": "statecli.undo",
        "title": "StateCLI: Undo Last Change",
        "icon": "$(discard)"
      },
      {
        "command": "statecli.trackCurrentFile",
        "title": "StateCLI: Track Current File",
        "icon": "$(eye)"
      },
      {
        "command": "statecli.viewHistory",
        "title": "StateCLI: View History",
        "icon": "$(list-unordered)"
      },
      {
        "command": "statecli.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "statecli.toggleTracking",
        "title": "StateCLI: Toggle Auto-Tracking",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "statecli.refresh",
          "when": "view == statecli.historyView",
          "group": "navigation"
        },
        {
          "command": "statecli.checkpoint",
          "when": "view == statecli.checkpointsView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "statecli.trackCurrentFile",
          "group": "statecli",
          "when": "editorTextFocus"
        },
        {
          "command": "statecli.undo",
          "group": "statecli",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "StateCLI",
      "properties": {
        "statecli.autoSetup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically configure MCP server on activation"
        },
        "statecli.mcpConfigPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to MCP config file (leave empty for default)"
        },
        "statecli.autoTrack": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start tracking file changes on activation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0"
  }
}