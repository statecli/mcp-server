# StateCLI Environment Variables
# Copy to .env and fill in values

# ── Core ──────────────────────────────────────────────────────
# Where StateCLI stores state files (default: ./.statecli)
STATECLI_DATA_DIR=./.statecli

# ── Telemetry ─────────────────────────────────────────────────
# Set to "true" to disable anonymous usage analytics
STATECLI_NO_TELEMETRY=false

# ── Dashboard ─────────────────────────────────────────────────
# Port for the analytics dashboard server
DASHBOARD_PORT=4000

# ── Shared Sessions ───────────────────────────────────────────
# Namespace for multi-agent session sharing
# Example: "team:my-project" or "org:acme"
STATECLI_SESSION_NAMESPACE=

# ── Cloud / Production ────────────────────────────────────────
NODE_ENV=production
